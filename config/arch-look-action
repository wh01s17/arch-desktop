#!/usr/bin/env bash
set -euo pipefail

shell_path="$HOME/.config/arch-look/shell.qml"
say() { notify-send 'Arch look' "$1"; }
menu() { quickshell ipc -p "$shell_path" call arch-look toggle "${1:-root}"; }
need() { command -v "$1" >/dev/null 2>&1 || { say "Falta instalar $1"; exit 1; }; }

case "${1:-}" in
  noop) : ;;
  close-all) say 'Cierre masivo omitido: cierra ventanas con Super+W.' ;;
  width-save) say 'El ancho de ventana guardado por Omarchy no está portado.' ;;
  width-restore) say 'El ancho de ventana guardado por Omarchy no está portado.' ;;
  layout-toggle)
    workspace_info="$(hyprctl activeworkspace -j)"
    workspace="$(jq -r '.id' <<< "$workspace_info")"
    [[ $workspace =~ ^([1-9]|10)$ ]] || { say 'Este atajo usa los espacios 1 a 10.'; exit 1; }
    layout="$(jq -r '.tiledLayout' <<< "$workspace_info")"
    if [[ $layout == dwindle ]]; then next=scrolling; else next=dwindle; fi
    hyprctl eval "hl.workspace_rule({ workspace = \"$workspace\", layout = \"$next\" })" >/dev/null
    mkdir -p "$HOME/.local/state/arch-look-workspace-layouts"
    printf '%s\n' "$next" > "$HOME/.local/state/arch-look-workspace-layouts/$workspace"
    say "Layout del espacio $workspace: $next"
    ;;
  window-pop) hyprctl dispatch 'hl.dsp.window.float({ action = "toggle" })' ;;
  tiled-fullscreen) hyprctl dispatch 'hl.dsp.window.fullscreen({ mode = "maximized" })' ;;
  scale-up|scale-down) wdisplays ;;
  dictation-toggle) need voxtype; voxtype record toggle ;;
  dictation-start) need voxtype; voxtype record start ;;
  dictation-stop) need voxtype; voxtype record stop ;;
  lid-close) hyprlock ;;
  lid-open) hyprctl dispatch 'hl.dsp.dpms({ action = "on" })' ;;
  agent) xdg-open https://chatgpt.com ;;
  webcam-smaller|webcam-larger) say 'No hay overlay de cámara configurado en Arch.' ;;
  menu) menu root ;;
  apps) wofi --show drun ;;
  system-menu) menu system ;;
  keybindings) kitty -e sh -c 'cat "$HOME/.config/arch-look/KEYBINDINGS.md"; printf "\nEnter para cerrar"; read -r _' ;;
  terminal) kitty ;;
  browser) firefox ;;
  browser-private) firefox --private-window ;;
  files) nautilus ;;
  editor) kitty -e nvim ;;
  tmux) kitty -e tmux ;;
  obsidian) need obsidian; obsidian ;;
  spotify) need spotify; spotify ;;
  music-tui) need cliamp; kitty -e cliamp ;;
  docker-tui) need lazydocker; kitty -e lazydocker ;;
  signal) need signal-desktop; signal-desktop ;;
  omawrite) say 'Omawrite es una aplicación de Omarchy; instala un editor equivalente si la necesitas.' ;;
  passwords) need 1password; 1password ;;
  web-chatgpt) firefox https://chatgpt.com ;;
  web-grok) firefox https://grok.com ;;
  web-calendar) firefox https://app.hey.com/calendar/weeks/ ;;
  web-email) firefox https://app.hey.com ;;
  web-new-email) firefox 'https://app.hey.com/messages/new?display=standalone&new_window=true' ;;
  web-youtube) firefox https://youtube.com/ ;;
  web-whatsapp) firefox https://web.whatsapp.com/ ;;
  web-messages) firefox https://messages.google.com/web/conversations ;;
  web-photos) firefox https://photos.google.com/ ;;
  web-maps) firefox https://maps.google.com/ ;;
  web-x) firefox https://x.com/ ;;
  web-x-post) firefox https://x.com/compose/post ;;
  activity) kitty -e btop ;;
  audio) pavucontrol ;;
  bluetooth) blueman-manager ;;
  display) wdisplays ;;
  network) nm-connection-editor ;;
  calendar) menu calendar ;;
  emojis) printf '😀\n😎\n🔥\n✅\n❌\n❤️\n' | wofi --dmenu | wl-copy ;;
  power) menu system ;;
  lock) hyprlock ;;
  logout)
    zenity --question --title='Cerrar sesión' --text='¿Cerrar la sesión actual?' || exit 0
    hyprctl dispatch 'hl.dsp.exit()'
    ;;
  reboot)
    zenity --question --title='Reiniciar' --text='¿Reiniciar el equipo?' || exit 0
    systemctl reboot
    ;;
  poweroff)
    zenity --question --title='Apagar' --text='¿Apagar el equipo?' || exit 0
    systemctl poweroff
    ;;
  screenshot)
    mkdir -p "$HOME/Pictures/Screenshots"
    selection="$(slurp)" || exit 0
    grim -g "$selection" "$HOME/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png"
    ;;
  ocr)
    need tesseract
    selection="$(slurp)" || exit 0
    grim -g "$selection" - | tesseract stdin stdout | wl-copy
    say 'Texto copiado al portapapeles'
    ;;
  screenrecord)
    if pgrep -x wf-recorder >/dev/null; then
      pkill -INT -x wf-recorder
    else
      mkdir -p "$HOME/Videos/Screencasts"
      selection="$(slurp)" || exit 0
      wf-recorder -g "$selection" -f "$HOME/Videos/Screencasts/$(date +%Y-%m-%d_%H-%M-%S).mp4" &
    fi
    ;;
  clipboard) cliphist list | wofi --dmenu | cliphist decode | wl-copy ;;
  color-picker) hyprpicker -a ;;
  calculator) kitty -e qalc ;;
  share) menu root ;;
  transcode) need ffmpeg; say 'Usa ffmpeg con el archivo y formato que elijas.' ;;
  reminder-set)
    need zenity
    minutes="$(zenity --entry --title='Recordatorio' --text='¿En cuántos minutos?')" || exit 0
    [[ $minutes =~ ^[1-9][0-9]*$ ]] || { say 'Introduce un número de minutos.'; exit 1; }
    message="$(zenity --entry --title='Recordatorio' --text='Mensaje')" || exit 0
    systemd-run --user --on-active="${minutes}m" --unit="arch-look-reminder-$(date +%s)" notify-send 'Recordatorio' "$message" >/dev/null
    ;;
  reminders) systemctl --user list-timers 'arch-look-reminder-*' ;;
  reminders-clear) systemctl --user stop 'arch-look-reminder-*' 2>/dev/null || true ;;
  time-notify) say "$(date '+%H:%M:%S')" ;;
  battery-notify)
    battery="$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null || true)"
    if [[ -n "$battery" ]]; then say "${battery}%"; else say 'Sin batería'; fi
    ;;
  weather) say 'Configura una fuente de clima para este equipo.' ;;
  idle-toggle)
    if pgrep -x hypridle >/dev/null; then pkill -x hypridle; say 'Bloqueo automático pausado'; else hypridle & say 'Bloqueo automático activo'; fi
    ;;
  nightlight-toggle)
    if pgrep -x hyprsunset >/dev/null; then pkill -x hyprsunset; else hyprsunset -t 4500 & fi
    ;;
  opacity-toggle) say 'El cambio de transparencia requiere una regla por ventana.' ;;
  gaps-toggle) say 'Los espacios están fijados por la configuración de Hyprland.' ;;
  square-toggle) say 'El modo cuadrado de Omarchy no está portado.' ;;
  display-toggle|display-mirror) wdisplays ;;
  zoom-in|zoom-reset) say 'Zoom de Hyprland pendiente de portar.' ;;
  wallpaper-start|background)
    state="$HOME/.local/state/arch-look-wallpaper"
    current=1
    if [[ -f "$state" && "$(cat "$state")" == 2 ]]; then current=2; fi
    if [[ ${1:-} == background ]]; then
      if [[ $current == 2 ]]; then current=1; else current=2; fi
      printf '%s\n' "$current" > "$state"
    fi
    pkill -x swaybg || true
    swaybg -i "$HOME/.config/arch-look/wallpaper-$current.png" -m fill &
    ;;
  theme) say 'El perfil visual wh01s17 es el único instalado en Arch.' ;;
  bar) quickshell ipc -p "$shell_path" call arch-look bar ;;
  notifications) swaync-client -t ;;
  notifications-dnd) swaync-client -d ;;
  notification-dismiss) swaync-client -C ;;
  notification-dismiss-all) swaync-client -C ;;
  volume-up) wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+ ;;
  volume-down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
  volume-mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
  volume-up-precise) wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 1%+ ;;
  volume-down-precise) wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%- ;;
  mic-mute) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
  brightness-up) brightnessctl set +5% ;;
  brightness-down) brightnessctl set 5%- ;;
  brightness-up-precise) brightnessctl set +1% ;;
  brightness-down-precise) brightnessctl set 1%- ;;
  brightness-max) brightnessctl set 100% ;;
  brightness-min) brightnessctl set 1% ;;
  kbd-brightness-up) brightnessctl -d '*::kbd_backlight' set +10% ;;
  kbd-brightness-down) brightnessctl -d '*::kbd_backlight' set 10%- ;;
  kbd-brightness-toggle) brightnessctl -d '*::kbd_backlight' set 0% ;;
  touchpad-toggle|touchpad-on|touchpad-off) say 'Ajusta el nombre del touchpad de este equipo para activar este atajo.' ;;
  eject) need eject; eject ;;
  media-play) playerctl play-pause ;;
  media-next) playerctl next ;;
  media-prev) playerctl previous ;;
  wayscriber-toggle) need wayscriber; wayscriber --daemon-toggle ;;
  wayscriber-passthrough) need wayscriber; wayscriber --light-toggle ;;
  wayscriber-draw) need wayscriber; wayscriber --light-draw-toggle ;;
  *) say "Acción desconocida: ${1:-vacía}"; exit 2 ;;
esac
