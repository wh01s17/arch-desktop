export PATH="$HOME/.local/bin:$PATH"
ZSH_THEME=""
omp-theme() { zsh "$HOME/.config/oh-my-posh/theme-picker.zsh" "$@"; }

_omp_active_config="$HOME/.config/oh-my-posh/active.omp.json"
if command -v jq >/dev/null && jq -e '.var.omp_right_above_input == true' "$_omp_active_config" >/dev/null 2>&1; then
  export POSH_DISABLE_STREAMING=omp-right-above-input
fi
unset _omp_active_config

eval "$(oh-my-posh init zsh --config "$HOME/.config/oh-my-posh/active.omp.json" --strict)"

typeset -gi _arch_omp_command_ran=0
_arch_omp_preexec() { _arch_omp_command_ran=1; }
_arch_omp_precmd() {
  if (( _arch_omp_command_ran )); then
    print
    _arch_omp_command_ran=0
  fi
}
autoload -Uz add-zsh-hook
add-zsh-hook preexec _arch_omp_preexec
add-zsh-hook precmd _arch_omp_precmd
